{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kernelpanic2015/ascp/schema/job.schema.json",
  "title": "ASCP Job",
  "type": "object",
  "required": ["id", "title", "status", "description", "acceptance_criteria"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["open", "claimed", "done", "cancelled"]
    },
    "priority": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "category": {
      "type": "string",
      "enum": ["documentation", "code", "design", "research", "other"]
    },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced"]
    },
    "description": { "type": "string" },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "suggested_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "labels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "estimated_effort": {
      "type": "string",
      "enum": ["small", "medium", "large"]
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
